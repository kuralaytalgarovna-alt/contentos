# Copy to .env and fill in as needed. Every value has a working default for
# local development, so an empty .env is fine to start.

ENVIRONMENT=development

# Defaults to a local SQLite file (backend/contentos.db). Switch to Postgres
# once it's available, e.g.:
# DATABASE_URL=postgresql+psycopg://contentos:contentos@localhost:5432/contentos
DATABASE_URL=

SECRET_KEY=dev-secret-key-change-me

# Optional. Leave empty to use the built-in mock idea/text generator.
ANTHROPIC_API_KEY=
